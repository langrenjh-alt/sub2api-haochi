# Backend integrated collector: no separate timer or upstream credentials.
# Use a verified actual group ID if the name is missing/ambiguous.
# POOL_RUNWAY_GROUP_ID=123
POOL_RUNWAY_GROUP_NAME=正常组

# Only needed for the standalone local CLI; backend uses its existing sql.DB.
# Business SELECTs use READ ONLY REPEATABLE READ transactions.
# Grant SELECT on accounts/account_groups/groups/proxies and DML on monitoring tables only.
# POOL_RUNWAY_DATABASE_URL=host=127.0.0.1 port=5432 dbname=sub2api user=runway_monitor sslmode=require
